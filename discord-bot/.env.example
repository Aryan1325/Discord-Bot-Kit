# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Application (client) ID from the same Discord Developer Portal page
DISCORD_CLIENT_ID=

# Optional: set this to a Discord server (guild) ID to register slash
# commands only in that server (updates instantly, good for development).
# Leave empty to register commands globally (can take up to 1 hour to
# propagate, but works in every server the bot joins).
DISCORD_GUILD_ID=
